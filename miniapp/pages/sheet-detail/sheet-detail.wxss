.sheet-detail-page {
  padding: 24rpx;
}

.sheet-detail-page .card {
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.sheet-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.progress {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.readonly-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--warning);
}

.share-btn {
  margin-top: 24rpx;
  margin-left: 0;
  margin-right: 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.item-row:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dish-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.item-status {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.claimant {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.item-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}

.recipe-link {
  font-size: 26rpx;
  color: var(--primary);
  text-align: center;
}

.complete-btn {
  margin-top: 8rpx;
}

.badge-pill.is-shared,
.badge-pill.is-in_progress {
  background: #eff6ff;
  color: #1d4ed8;
}

.badge-pill.is-completed {
  background: var(--accent-weak);
  color: var(--accent);
}
