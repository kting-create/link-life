.sheet-detail-page {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: bold;
}

.sheet-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  background: #e8f7ef;
  color: var(--primary);
}

.progress {
  font-size: 24rpx;
  color: #999999;
}

.readonly-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #fa9d3b;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f6f6f6;
}

.item-main {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
}

.dish-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.item-status {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.status-text {
  color: var(--primary);
}

.claimant {
  color: #999999;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
}

.recipe-link {
  font-size: 26rpx;
  color: var(--primary);
  text-align: center;
}

.complete-btn {
  margin-top: 20rpx;
}

.hint {
  text-align: center;
  color: #999999;
  padding: 60rpx 0;
}
