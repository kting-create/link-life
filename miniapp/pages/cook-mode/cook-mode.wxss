.cook { padding: 24rpx; min-height: 100vh; box-sizing: border-box; }
.progress-line { height: 16rpx; background: var(--border); border-radius: 999rpx; overflow: hidden; }
.progress-inner { height: 100%; background: var(--primary); border-radius: 999rpx; transition: width .5s; }
.head { text-align: center; margin: 24rpx 0; color: var(--text-secondary); }
.step-text { font-size: 56rpx; line-height: 1.6; margin: 48rpx 0; text-align: center; color: var(--text-primary); }
.timer { text-align: center; margin: 32rpx 0; }
.remain { font-size: 120rpx; font-weight: 700; color: var(--primary); }
.timer-btns { display: flex; justify-content: center; gap: 16rpx; margin-top: 24rpx; }
.nav { display: flex; gap: 16rpx; margin-top: 24rpx; }
.nav .btn { flex: 1; }
.no-timer { text-align: center; color: var(--text-secondary); margin: 32rpx 0; }
.photos { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 32rpx; }
.photo { width: 200rpx; }
.photo image { width: 200rpx; height: 200rpx; border-radius: var(--radius-sm); }
.photo-ops { text-align: center; margin-top: 8rpx; }
.ai-btn { color: var(--primary); font-size: 24rpx; }
.advice { background: var(--primary-weak); border: 1rpx solid var(--border); border-radius: var(--radius);
  padding: 24rpx; margin-top: 32rpx; }
.advice-title { color: var(--primary-deep); font-weight: 700; margin-bottom: 12rpx; }
.advice-body { color: var(--text-primary); line-height: 1.6; }
.advice-change { color: var(--text-secondary); font-size: 26rpx; margin-top: 8rpx; }
.advice-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.advice-btns .btn { flex: 1; }
