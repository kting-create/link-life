.profile-page {
  padding: 24rpx;
}

.profile-card {
  background: #ffffff;
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.avatar-placeholder {
  background: var(--primary);
  color: #ffffff;
  text-align: center;
  line-height: 120rpx;
  font-size: 48rpx;
}

.field {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
}

.field-label {
  width: 120rpx;
  color: #666666;
}

.field-input {
  flex: 1;
  border-bottom: 1rpx solid #eeeeee;
  padding: 12rpx 0;
}

.binding-card {
  background: #ffffff;
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.binding-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.binding-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.binding-result {
  margin-top: 24rpx;
  text-align: center;
}

.binding-code {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 12rpx;
  color: var(--primary);
}

.binding-expires {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.taste-card {
  background: #ffffff;
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.taste-summary {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.taste-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.taste-tag {
  padding: 8rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 24rpx;
  background: rgba(7, 193, 96, 0.1);
  color: var(--primary);
  font-size: 24rpx;
}

.taste-empty {
  font-size: 26rpx;
  color: #999999;
}

.nav-card {
  background: #ffffff;
  border-radius: var(--radius);
  padding: 32rpx;
}

.nav-link {
  text-align: center;
  color: var(--primary);
}

.nav-link-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  margin-left: 12rpx;
}

.logout-btn {
  margin-top: 48rpx;
  background: #ffffff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: var(--radius);
  font-size: 30rpx;
}
