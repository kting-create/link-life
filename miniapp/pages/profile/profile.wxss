.profile-page {
  padding: 24rpx;
}

.profile-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.avatar-placeholder {
  background: #07c160;
  color: #ffffff;
  text-align: center;
  line-height: 120rpx;
  font-size: 48rpx;
}

.field {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
}

.field-label {
  width: 120rpx;
  color: #666666;
}

.field-input {
  flex: 1;
  border-bottom: 1rpx solid #eeeeee;
  padding: 12rpx 0;
}

.binding-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.binding-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.binding-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.binding-result {
  margin-top: 24rpx;
  text-align: center;
}

.binding-code {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 12rpx;
  color: #07c160;
}

.binding-expires {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.nav-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
}

.nav-link {
  text-align: center;
  color: #07c160;
}
