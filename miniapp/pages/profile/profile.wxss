.profile-page {
  padding: 24rpx;
}

.profile-card {
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-card {
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.avatar-placeholder {
  background: var(--primary);
  color: #ffffff;
  text-align: center;
  line-height: 120rpx;
  font-size: 48rpx;
}

.field {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
}

.field-label {
  width: 120rpx;
  color: var(--text-secondary);
}

.field-input {
  flex: 1;
  border-bottom: 1rpx solid var(--border);
  padding: 12rpx 0;
}

.save-btn {
  min-width: 160rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.section-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.binding-result {
  margin-top: 24rpx;
  text-align: center;
}

.binding-code {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--primary);
}

.binding-result .section-desc {
  margin-bottom: 0;
}

.taste-summary {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.taste-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.taste-tag {
  padding: 8rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: var(--primary-weak);
  color: var(--primary-deep);
  font-size: 24rpx;
}

.nav-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.nav-link:last-child {
  border-bottom: none;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.logout-btn {
  margin-top: 48rpx;
  width: 100%;
}
