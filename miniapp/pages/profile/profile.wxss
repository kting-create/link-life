.profile-page {
  padding: var(--space-3);
}

.profile-card {
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-3);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-card {
  position: relative;
  margin-bottom: var(--space-3);
  overflow: hidden;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: var(--space-3);
}

/* 白字为实底/渐变上的 on-color 约定（同 app.wxss .btn-primary） */
.avatar-placeholder {
  background: var(--primary);
  color: #ffffff;
  text-align: center;
  line-height: 120rpx;
  font-size: var(--text-xl);
}

.profile-card .field {
  width: 100%;
}

.save-btn {
  min-width: 160rpx;
}

.section-title {
  position: relative;
  z-index: 1;
  font-size: var(--text-md);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-1);
}

.section-desc {
  position: relative;
  z-index: 1;
  font-size: var(--text-xs);
  color: var(--text-secondary);
  margin-bottom: var(--space-3);
}

.binding-result {
  position: relative;
  z-index: 1;
  margin-top: var(--space-3);
  text-align: center;
}

.binding-code {
  font-size: var(--text-2xl);
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--primary);
}

.binding-result .section-desc {
  margin-bottom: 0;
}

.taste-card {
  border-radius: var(--radius-lg);
}

.taste-glow {
  width: 320rpx;
  height: 320rpx;
  top: -72rpx;
  right: -72rpx;
}

.taste-summary {
  position: relative;
  z-index: 1;
  font-size: var(--text-sm);
  color: var(--text-primary);
  line-height: 1.6;
}

.taste-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-2);
  gap: var(--space-1);
}

.taste-tag {
  margin: 0;
}

.nav-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 var(--space-2);
  margin: 0 calc(var(--space-2) * -1);
  color: var(--text-primary);
  font-size: var(--text-sm);
  border-bottom: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  transition: background-color 0.2s ease;
}

.nav-link:last-child {
  border-bottom: none;
}

.nav-hover {
  background-color: var(--primary-weak);
}

/* 白字为实底上的 on-color 约定 */
.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 var(--space-1);
  border-radius: var(--radius-pill);
  background: var(--danger);
  color: #ffffff;
  font-size: var(--text-xs);
  line-height: 32rpx;
  text-align: center;
}

.logout-btn {
  margin-top: var(--space-5);
  width: 100%;
}
