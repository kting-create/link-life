.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: var(--space-5);
  box-sizing: border-box;
}

.brand-card {
  position: relative;
  width: 100%;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-7) var(--space-4);
  overflow: hidden;
}

.login-glow {
  width: 360rpx;
  height: 360rpx;
  top: -80rpx;
  right: -80rpx;
}

.login-logo {
  position: relative;
  z-index: 1;
  font-size: var(--text-3xl);
  font-weight: 700;
  color: var(--primary);
}

.login-subtitle {
  position: relative;
  z-index: 1;
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.login-btn {
  margin-top: var(--space-6);
  width: 100%;
  height: 112rpx;
}
