.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
}

.brand-card {
  width: 100%;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
}

.login-logo {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary);
}

.login-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.login-btn {
  margin-top: 80rpx;
  width: 100%;
  height: 112rpx;
}
