.circle-page {
  padding: 24rpx;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.topbar-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.topbar-profile {
  font-size: 28rpx;
  color: var(--primary);
}

.tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: var(--text-tertiary);
}

.tab-active {
  color: var(--primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--primary);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
  padding: 16rpx 0;
}

.circle-item {
  margin-bottom: 20rpx;
}

.circle-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.circle-code {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.member-circles {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.member-circle-chip {
  padding: 10rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.chip-active {
  background: var(--primary);
  border-color: var(--primary);
  color: #ffffff;
}

.member-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.member-avatar-placeholder {
  background: var(--primary-weak);
  color: var(--primary-deep);
  text-align: center;
  line-height: 72rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.member-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.member-role {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.empty-main {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
