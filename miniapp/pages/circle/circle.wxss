.circle-page {
  position: relative;
  padding: var(--space-3);
}

.page-glow {
  width: 320rpx;
  height: 320rpx;
  top: -60rpx;
  right: -60rpx;
}

.topbar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.topbar-title {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.topbar-profile {
  font-size: var(--text-sm);
  color: var(--primary);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  transition: background-color 0.2s ease;
}

.link-hover {
  background-color: var(--primary-weak);
}

.actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: var(--space-2);
  margin: var(--space-3) 0;
}

.action-btn {
  flex: 1;
  margin: 0;
  padding: var(--space-2) 0;
}

.circle-item {
  position: relative;
  z-index: 1;
  margin-bottom: var(--space-2);
}

.circle-name {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--text-primary);
}

.circle-code {
  margin-top: var(--space-1);
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

.member-circles {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: var(--space-3) 0;
}

.member-circle-chip {
  padding: var(--space-1) var(--space-3);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  transition: transform 0.18s var(--ease-spring-tap), box-shadow 0.2s ease;
}

.member-circle-chip.chip-hover {
  transform: scale(0.96);
}

/* 白字为渐变上的 on-color 约定（同 app.wxss .btn-primary） */
.chip-active {
  background: var(--grad-flame);
  border-color: transparent;
  color: #ffffff;
  box-shadow: var(--shadow-glow);
}

.member-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-2);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: var(--space-2);
}

.member-avatar-placeholder {
  background: var(--primary-weak);
  color: var(--primary-deep);
  text-align: center;
  line-height: 72rpx;
  font-size: var(--text-md);
  font-weight: 600;
  box-shadow: var(--shadow-glow);
}

.member-name {
  flex: 1;
  font-size: var(--text-md);
  color: var(--text-primary);
}

.member-role {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}
