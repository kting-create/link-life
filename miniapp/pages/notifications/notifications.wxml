<view class="page">
  <view class="head">
    <text class="title">我的通知</text>
    <button class="btn btn-secondary btn-small" hover-class="button-hover" bindtap="readAll">全部已读</button>
  </view>
  <skeleton wx:if="{{loading && !items.length}}" rows="3" />
  <empty-state wx:elif="{{items.length === 0}}" title="暂无通知" />
  <view wx:else class="stagger-list {{listRun ? 'run' : ''}}">
    <view
      class="item card clickable stagger-item"
      style="--i: {{index}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-sheetid="{{item.sheetId}}"
      data-read="{{item.read}}"
      hover-class="button-hover"
      hover-stay-time="80"
      bindtap="openItem"
    >
      <view class="row">
        <view wx:if="{{!item.read}}" class="unread-bar"></view>
        <text class="{{item.read ? '' : 'unread'}}">{{item.title}}</text>
      </view>
      <view class="content">{{item.content}}</view>
    </view>
  </view>
  <button
    wx:if="{{items.length >= 20}}"
    class="btn btn-secondary load-more"
    hover-class="button-hover"
    bindtap="loadMore"
  >加载更多</button>
</view>
<glass-toast id="gtoast" />
