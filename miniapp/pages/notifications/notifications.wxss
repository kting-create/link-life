.page { padding: 24rpx; }
.head { display: flex; align-items: center; padding: 8rpx 8rpx 24rpx; }
.title { font-size: 40rpx; font-weight: 700; color: var(--text-primary); flex: 1; }
.read-all { color: var(--primary); font-size: 28rpx; }
.item { margin-bottom: 20rpx; }
.row { display: flex; align-items: center; }
.dot { width: 12rpx; height: 32rpx; border-radius: 999rpx; background: var(--primary); margin-right: 16rpx; }
.unread { font-weight: 600; color: var(--text-primary); }
.content { color: var(--text-tertiary); font-size: 24rpx; margin-top: 8rpx; margin-left: 28rpx; }
