.sheet-list-page {
  padding: 24rpx 24rpx 160rpx;
}

.header {
  margin-bottom: 24rpx;
}

.circle-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  box-shadow: var(--shadow-card);
  z-index: 10;
}

.sheet-item {
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.sheet-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.progress {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.badge-pill.badge-shared,
.badge-pill.is-shared,
.badge-pill.badge-in_progress,
.badge-pill.is-in_progress {
  background: #eff6ff;
  color: #1d4ed8;
}

.badge-pill.badge-completed,
.badge-pill.is-completed {
  background: var(--accent-weak);
  color: #047857;
}
