.order-create-page {
  padding: 24rpx;
}

.form-card {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.title-input {
  margin-bottom: 8rpx;
  font-size: 30rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.item-inputs {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dish-input {
  font-size: 28rpx;
}

.note-input {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.row-remove {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}

.add-row {
  text-align: center;
  color: var(--primary);
  font-size: 28rpx;
  padding: 16rpx 0;
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 112rpx;
}
