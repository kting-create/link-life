.order-create-page {
  padding: var(--space-3);
}

.form-card {
  margin-bottom: var(--space-3);
}

.field-label {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-bottom: var(--space-2);
}

.item-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.item-inputs {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.item-inputs .field {
  margin-bottom: 0;
}

.add-row {
  text-align: center;
  color: var(--primary);
  font-size: var(--text-sm);
  font-weight: 600;
  padding: var(--space-2) 0;
  border-radius: var(--radius-sm);
  transition: background-color 0.2s ease;
}

.link-hover {
  background-color: var(--primary-weak);
}

.submit-btn {
  margin-top: var(--space-5);
  width: 100%;
  height: 112rpx;
}
