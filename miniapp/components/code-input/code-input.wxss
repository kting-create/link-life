/* code-input — 对照 web/src/components/CodeInput.vue（rpx = web px × 2）
   .code-cell 合并 web 的 .code-cell.input 两套样式，避免与全局 .input 的 width:100% 打架 */

.code-input {
  display: flex;
  gap: var(--space-2);
}
.code-cell {
  width: 88rpx;
  height: 108rpx;
  text-align: center;
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.18s var(--ease-spring-tap);
}
.code-cell-focus {
  transform: scale(1.06);
  border-color: var(--primary);
  box-shadow: var(--shadow-glow);
}
