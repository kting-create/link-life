/* miniapp/app.wxss — Warm Glass token 层与全局类（对照 web/src/styles/tokens.css + style.css，rpx = web px × 2） */
page {
  background-color: #faf6f1;
  background-image: linear-gradient(165deg, #faf6f1 0%, #fff7ed 45%, #f3ece5 100%);
  font-size: var(--text-sm);
  color: var(--text-primary);
  /* 色 · 陶土橙唯一强调 */
  --primary: #c2410c;
  --primary-hot: #ea580c;
  --primary-deep: #9a3412;
  --primary-weak: #fff1e6;
  --grad-flame: linear-gradient(135deg, #c2410c, #ea580c);
  --accent: #059669;
  --accent-deep: #047857;
  --accent-weak: #ecfdf5;
  --grad-done: linear-gradient(135deg, #047857, #059669);
  --grad-cooking: linear-gradient(135deg, #1d4ed8, #3b82f6);
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-tertiary: #94a3b8;
  --bg-page: linear-gradient(165deg, #faf6f1 0%, #fff7ed 45%, #f3ece5 100%);
  --bg-card: #ffffff;
  --border: #f2e6e2;
  --danger: #dc2626;
  --danger-hot: #ef4444;
  --grad-danger: linear-gradient(135deg, #dc2626, #ef4444);
  --warning: #f59e0b;
  --ring: #9a3412;
  /* 玻璃（全局唯一参数，页面禁改）；--glass-bg 保持 web .65 以便 token 对照，
     玻璃面类上另给 .82 兜底（见 .card/.glass-card 注释） */
  --glass-bg: rgba(255, 255, 255, 0.65);
  --glass-bg-strong: rgba(255, 255, 255, 0.88);
  --glass-border: rgba(255, 255, 255, 0.85);
  --glass-blur: blur(32rpx);
  --glass-highlight: inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
  /* 光晕/阴影 */
  --shadow-card: 0 16rpx 56rpx rgba(154, 52, 18, 0.1), inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
  --shadow-press: 0 2rpx 4rpx rgba(154, 52, 18, 0.1);
  --shadow-glow: 0 4rpx 16rpx rgba(194, 65, 12, 0.35);
  --shadow-lift: 0 28rpx 68rpx rgba(154, 52, 18, 0.14);
  --glow-terracotta: radial-gradient(circle, rgba(194, 65, 12, 0.18), transparent 70%);
  /* 几何 */
  --radius-lg: 48rpx;
  --radius: 32rpx;
  --radius-sm: 20rpx;
  --radius-pill: 999rpx;
  /* 间距阶梯 */
  --gap: var(--space-3);
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;
  --space-7: 96rpx;
  /* 字阶 */
  --text-xs: 24rpx;
  --text-sm: 28rpx;
  --text-md: 32rpx;
  --text-lg: 40rpx;
  --text-xl: 48rpx;
  --text-2xl: 56rpx;
  --text-3xl: 64rpx;
  /* 动效（与 web motion.js 数值一致） */
  --duration-exit: 200ms;
  --duration-page: 450ms;
  --stagger-item: 60ms;
  --ease-out-soft: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-spring-tap: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 玻璃三件套：背景 + 模糊 + 亮边 */
/* 注意：小程序部分基础库不支持 backdrop-filter，玻璃面背景直接用 .82 白
   （比 web --glass-bg 的 .65 不透明一点），无模糊兜底时仍保文字可读 */
.card,
.glass-card {
  background: rgba(255, 255, 255, 0.82);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 2rpx solid var(--glass-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  transition: transform 0.3s var(--ease-out-soft), box-shadow 0.3s ease;
}
.card.clickable.button-hover {
  transform: scale(0.985);
  box-shadow: var(--shadow-press);
}

.glow-orb {
  position: absolute;
  border-radius: 50%;
  background: var(--glow-terracotta);
  filter: blur(16rpx);
  pointer-events: none;
  z-index: 0;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  position: relative;
  overflow: hidden;
  border: none;
  border-radius: var(--radius-pill);
  font-weight: 700;
  font-size: var(--text-sm);
  padding: var(--space-2) var(--space-4);
  line-height: 1.4;
  transition: transform 0.18s var(--ease-spring-tap), box-shadow 0.2s ease;
}
.btn::after {
  border: none;
}
.btn.button-hover {
  transform: scale(0.96);
}
.btn-primary {
  background: var(--grad-flame);
  color: #ffffff;
  box-shadow: var(--shadow-glow);
}
/* 一次性流光：常态停在左侧外，hover-class 按压时播放一次 */
.btn-primary::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 45%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  pointer-events: none;
  transform: translateX(-120%);
}
.btn-primary.button-hover::after {
  animation: btn-shine 0.7s ease 1;
}
@keyframes btn-shine {
  from { transform: translateX(-120%); }
  to { transform: translateX(320%); }
}
.btn-primary.button-hover {
  background: var(--primary-deep);
}
.btn-secondary {
  background: rgba(255, 255, 255, 0.75);
  color: var(--primary);
  border: 2rpx solid rgba(194, 65, 12, 0.25);
  box-shadow: var(--glass-highlight);
}
.btn-secondary.button-hover {
  background: var(--primary-weak);
  border-color: rgba(194, 65, 12, 0.45);
}
.btn-danger {
  background: var(--grad-danger);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(220, 38, 38, 0.3);
}
.btn-danger.button-hover {
  background: var(--danger);
}
.btn-accent {
  background: var(--grad-done);
  color: #ffffff;
  box-shadow: var(--shadow-glow);
}
.btn-accent.button-hover {
  background: var(--accent-deep);
}
.btn-ghost {
  background: rgba(255, 255, 255, 0.7);
  color: var(--primary);
  border: 2rpx solid rgba(194, 65, 12, 0.3);
}
.btn-ghost.button-hover {
  background: var(--primary-weak);
  color: var(--primary-deep);
}
.btn-small {
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
}
.btn-disabled,
.btn.button-disabled {
  opacity: 0.5;
}
.btn-disabled.button-hover::after,
.btn.button-disabled.button-hover::after {
  animation: none;
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--text-xs);
  font-weight: 700;
}
.badge-pill.is-open {
  background: rgba(255, 255, 255, 0.75);
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}
.badge-pill.is-claimed {
  background: var(--grad-flame);
  color: #ffffff;
  box-shadow: var(--shadow-glow);
}
.badge-pill.is-cooking {
  background: var(--grad-cooking);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(29, 78, 216, 0.3);
}
.badge-pill.is-done {
  background: var(--grad-done);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.3);
}
.badge-pill.is-warn {
  background: #fef3c7;
  color: #b45309;
}
.badge-pill.is-expired {
  background: #fee2e2;
  color: var(--danger);
}

.input {
  width: 100%;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-sm);
  color: var(--text-primary);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.input:focus,
.input-focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(194, 65, 12, 0.15);
}
.input::placeholder {
  color: var(--text-tertiary);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-3);
  padding: var(--space-7) var(--space-4);
  color: var(--text-secondary);
  font-size: var(--text-sm);
}

.empty-main {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--text-primary);
}

.empty-sub {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

.skeleton {
  height: 28rpx;
  border-radius: 14rpx;
  margin-bottom: var(--space-3);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.6) 25%, rgba(255, 255, 255, 0.95) 50%, rgba(255, 255, 255, 0.6) 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite;
}
@keyframes sk-shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

.stagger-item {
  opacity: 0;
}
.stagger-list.run .stagger-item {
  animation: st-in 0.5s var(--ease-out-soft) both;
  animation-delay: calc(var(--i, 0) * var(--stagger-item));
}
@keyframes st-in {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: none; }
}

.page-title {
  font-size: var(--text-lg);
  font-weight: 800;
  letter-spacing: -0.01em;
  margin: 0 0 var(--space-4);
  color: var(--text-primary);
}

.muted {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    animation: none !important;
  }
  .stagger-item {
    opacity: 1;
  }
}
